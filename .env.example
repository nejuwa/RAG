RIA_ENV=development
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/rag
QDRANT_LOCAL_PATH=data/qdrant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ANSWER_TIMEOUT_SECONDS=180
GEMINI_EMBEDDING_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=1
EMBEDDING_DIMENSIONS=768
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
MAX_URL_COUNT=5
DOMAIN_MIN_INTERVAL_SECONDS=1
CHUNK_SIZE=3200
CHUNK_OVERLAP=400
RETRIEVAL_TOP_K=12
